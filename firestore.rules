rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 상담실 방: 누구나 읽기 가능, 쓰기는 인증된 교사만
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email.matches('.*@dajeong\\.sjedues\\.kr');
    }

    // 상담 세션: 누구나 읽기/쓰기 가능 (학생 접근 허용)
    // 실제 운영 시에는 더 엄격한 규칙 적용 필요
    match /sessions/{sessionId} {
      allow read, write: if true;
    }
  }
}
