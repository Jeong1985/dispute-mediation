# ─────────────────────────────────────────────────────────
# Firebase 설정 (프로젝트: dajeonges2026)
# Firebase Console > 프로젝트 설정 > 앱 > SDK 구성에서 복사
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dajeonges2026.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dajeonges2026
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=dajeonges2026.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────
# Google Gemini API 키 (무료)
# https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────
# 이메일 발송 SMTP 설정 (Gmail 기준)
# Gmail > 계정 > 보안 > 앱 비밀번호에서 생성한 16자리 비밀번호 사용
# ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxxxxxxxxxx
SMTP_FROM="다정초 분쟁조정위원회 <your-email@gmail.com>"

# ─────────────────────────────────────────────────────────
# Google Drive 연동 (선택사항 - 설정 시 대화가 Drive에 자동 저장됨)
#
# [방법 1] 대상 폴더 ID 직접 지정 (권장)
#   Google Drive에서 '분쟁조정위원회' 폴더 열기
#   → 주소창 URL 끝 부분이 폴더 ID
#   → 이 폴더를 서비스 계정 이메일과 공유 (편집자 권한)
# ─────────────────────────────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=

# Google Cloud Console에서 생성한 서비스 계정 키 JSON (한 줄로 압축)
# GCP Console > IAM > 서비스 계정 > 키 추가 > JSON 다운로드
# Drive API 사용 설정 필요: https://console.cloud.google.com/apis/library/drive.googleapis.com
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
